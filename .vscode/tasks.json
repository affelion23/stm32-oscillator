{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Debug",
            "type": "shell",
            "command": "cmake --build --preset Debug; if ($?) { arm-none-eabi-size ./build/Debug/stm32f103bsp.elf }",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [],
            "detail": "Build All"
        },
        {
            "label": "Rebuild Debug",
            "type": "shell",
            "command": "cmake --build --preset Debug --clean-first; if ($?) { arm-none-eabi-size ./build/Debug/stm32f103bsp.elf }",
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "Rebuild All"
        },
        {
            "label": "Flash",
            "type": "shell",
            "command": "openocd",
            "args": [
                "-f",
                "interface/cmsis-dap.cfg",
                "-f",
                "target/stm32f1x.cfg",
                "-c",
                "reset_config none",
                "-c",
                "cortex_m reset_config sysresetreq",
                "-c",
                "adapter speed 1000",
                "-c",
                "program ./build/Debug/stm32f103bsp.elf verify reset exit"
            ],
            "group": "test",
            "problemMatcher": [],
            "detail": "BuidAll->Flash"
        },
        {
            "label": "Warmup GDB",
            "type": "shell",
            "command": "arm-none-eabi-gdb",
            "args": [
                "--batch",
                "-ex",
                "file ./build/Debug/stm32f103bsp.elf",
                "-ex",
                "quit"
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Debug with GDB warmup",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Build Debug",
                "Warmup GDB"
            ]
        }
    ]
}